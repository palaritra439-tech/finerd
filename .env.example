# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Generate a unique random secret with at least 32 bytes for API session signing.
# Do not put real deployment secrets in this example file or commit them.
FINERD_SESSION_SECRET=

# Local username/password accounts cannot satisfy this MFA requirement; when enabled, local sign-in is blocked.
FINERD_REQUIRE_MFA=false
# Optional override; defaults to ~/.finerd/accounts.json.
FINERD_ACCOUNT_STORE_FILE=
# Optional comma-separated account IDs from accounts.json that receive admin access.
FINERD_ADMIN_ACCOUNT_IDS=

# Local desktop/API default. Public hosting requires a trusted HTTPS proxy.
HOST=127.0.0.1
ALLOW_PUBLIC_BIND=false
PUBLIC_HTTPS=false
# Public HTTPS origin; required for publicly bound deployments.
PUBLIC_APP_URL=
# Set only to the number of trusted reverse-proxy hops, usually 1.
TRUST_PROXY_HOPS=

# Optional SEC-API.io key for issuer filing search and download.
# Keep the key in the server environment; never put it in client code or an APK.
# Use SEC_API_KEY (or SEC_API_IO_API_KEY as a legacy alias).
SEC_API_KEY=
SEC_API_IO_API_KEY=
# SEC requires an identifiable User-Agent with a valid contact email. Either set SEC_USER_AGENT,
# or set FINERD_SEC_CONTACT_EMAIL and Finerd will construct a User-Agent for you.
SEC_USER_AGENT=
FINERD_SEC_CONTACT_EMAIL=
